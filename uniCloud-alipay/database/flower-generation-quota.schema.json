{
  "bsonType": "object",
  "required": ["user_id", "day", "slot", "createdAt"],
  "permission": { "read": false, "create": false, "update": false, "delete": false },
  "properties": {
    "_id": { "bsonType": "string" },
    "user_id": { "bsonType": "string" },
    "day": { "bsonType": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "slot": { "bsonType": "int", "minimum": 1, "maximum": 3 },
    "createdAt": { "bsonType": "long" }
  }
}
